# Non copiarlo a mano: scripts/installa-servizio.sh mette utente e cartella giusti (§ 5.5 della guida).
[Unit]
Description=pi-dash su schermo 3,5" SPI
Wants=network-online.target
After=network-online.target time-sync.target

[Service]
Type=simple
User=pi
SupplementaryGroups=video input tty
# permette di spegnere la console di testo sullo schermo (KDSETMODE) senza girare come root
AmbientCapabilities=CAP_SYS_TTY_CONFIG
# luminosità dalle Impostazioni: la retroilluminazione (se il pannello la espone) scrivibile
# dal servizio; "+" = eseguito come root, "|| true" = nessun errore se non c'è
ExecStartPre=+/bin/sh -c 'chmod a+w /sys/class/backlight/*/brightness 2>/dev/null || true'
WorkingDirectory=/home/pi/pi-dash
ExecStart=/home/pi/pi-dash/.venv/bin/python -m dash
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
